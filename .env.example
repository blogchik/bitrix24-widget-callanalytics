# =============================================================================
# Call Analytics (texnobus.callanalytics) - environment template
# Copy to .env and fill in.  .env is gitignored; NEVER commit real values.
# Every variable below is a field of app/config.py:Settings (lowercased name).
# Reference: docs/architecture.md §10 (env list), §3 (roles), §5 (sync).
# =============================================================================

# ----------------------------------------------------------------- Bitrix24 app
# Vendor-cabinet application credentials (client_id / client_secret of the app).
B24_CLIENT_ID=local.000000000000.00000000
B24_CLIENT_SECRET=replace-with-vendor-cabinet-secret
# Comma-separated hostnames allowed as the OAuth refresh host; the host part of
# SERVER_ENDPOINT must be in this set or the portal is refused (§4.1).
OAUTH_HOST_ALLOWLIST=oauth.bitrix.info,oauth.bitrix24.tech
# Max refresh exchanges triggered by unauthenticated input, per member_id and
# per source IP, per 10 minutes (§4.1 - "do not refresh excessively").
OAUTH_EXCHANGE_LIMIT=5
# Public origin of this deployment; used to build handoff/placement URLs.
APP_BASE_URL=https://b24.texnobus.uz

# ----------------------------------------------------------------- database
# Runtime connection for api + worker: role ca_app, NOBYPASSRLS (§3).
DATABASE_URL=postgresql+asyncpg://ca_app:change-me-app-password@postgres:5432/callanalytics
# Alembic-only connection: role ca_owner owns the objects, sync psycopg driver (§3).
DATABASE_URL_MIGRATIONS=postgresql+psycopg://ca_owner:change-me-owner-password@postgres:5432/callanalytics
# Passwords consumed by docker/postgres/init.sql on the FIRST boot of the volume.
# They must match the two URLs above.
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_CA_OWNER_PASSWORD=change-me-owner-password
POSTGRES_CA_APP_PASSWORD=change-me-app-password

# ----------------------------------------------------------------- crypto / sessions
# Key ring for the AES-256-GCM token envelope: "<id>:<base64 of 32 random bytes>",
# comma-separated.  Old ids stay here so rotation is a background re-encrypt.
# Generate a real one with:
#   python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# The value below is a FAKE placeholder (32 zero bytes) - never use it anywhere real.
TOKEN_ENC_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Which key id from TOKEN_ENC_KEYS new ciphertext is written with.
TOKEN_ENC_ACTIVE_KEY_ID=1
# HS256 secret for the session JWT and the short-lived playback token (§4.6).
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# ----------------------------------------------------------------- sync cadence
# Seconds between incremental sync visits of one portal (§5.3).
SYNC_INTERVAL_SEC=300
# Seconds between ID-window rescans of one portal (§5.5).
RESCAN_INTERVAL_SEC=3600
# Width of the trailing rescan window in hours; sets rescan_from_id (§5.5).
RESCAN_WINDOW_HOURS=72
# Employee cache TTL in hours; placeholders are refreshed first (§7).
EMPLOYEE_TTL_HOURS=4
# How many portals the worker syncs in parallel - all tenants share one source IP (§5).
GLOBAL_PORTAL_CONCURRENCY=4
# Backfill batches per visit before the run yields, so one busy portal cannot
# starve the others (§5.2).
BACKFILL_BATCHES_PER_VISIT=20
# Fraction of the observed operating-time limit at which a visit stops early (§5.4).
OPERATING_SOFT_RATIO=0.8
# The adaptive operating-time limit is never lowered below this many seconds (§5.4).
OPERATING_LIMIT_FLOOR=300
# Outbound REST requests per second per portal (Basic plan bucket is 2/s) (§5.4).
SYNC_RATE_PER_SEC=2

# ----------------------------------------------------------------- logging / limits
# Days of rest_log kept before the batched DELETE removes rows.
# MUST be >= 3; app/config.py raises at startup otherwise (§6).
REST_LOG_RETENTION_DAYS=7
# Max bytes of a request/response body stored in rest_log before truncation (§6).
REST_LOG_BODY_LIMIT=262144
# Cap on crm.activity.list ids cached per CRM entity (250 = 5 pages x 50) (§4.8).
CRM_ACTIVITY_CAP=250

# ----------------------------------------------------------------- lifecycle
# Offer a credential re-seed to an admin opener once the refresh token is this
# many days old, so the 180-day chain never dies silently (§4.4).
TOKEN_RESEED_AFTER_DAYS=120
# Days without a successful admin open before a dead-token portal is treated as
# uninstalled and purged - the fallback uninstall path (§5.7).
UNINSTALL_GRACE_DAYS=30
# Hard cap on a custom dashboard period, in days (§5 / §10).
MAX_PERIOD_DAYS=366

# ----------------------------------------------------------------- runtime toggles
# off  = show a "has recording" icon and an openPath link (default until the §9 spike answers)
# proxy = stream the recording through the backend behind a signed URL
RECORDING_MODE=off
# Job backend implementation; only apscheduler exists in v1 (§5.8).
JOB_BACKEND=apscheduler
# 1 = run the scheduler inside the api process instead of the worker container (§11.13).
SCHEDULER_INLINE=0
# Python log level for the JSON stdout logger: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
